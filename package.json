{
  "name": "@port-experimental/port-sdk",
  "version": "0.2.5",
  "description": "Type-safe TypeScript SDK for Port.io API (Backend/Server-Side Only)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "types:download": "curl -o openapi.json https://api.port.io/swagger/json",
    "types:generate": "openapi-typescript openapi.json -o src/types/api.ts",
    "types:update": "pnpm types:download && pnpm types:generate",
    "types:check": "tsx scripts/check-types.ts",
    "types:validate": "pnpm type-check",
    "docs:api": "typedoc",
    "docs:clean": "rm -rf docs/api",
    "docs:generate": "pnpm docs:clean && pnpm docs:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:benchmark": "vitest run --config vitest.performance.config.ts",
    "version:patch": "npm version patch -m \"chore: release v%s\"",
    "version:minor": "npm version minor -m \"chore: release v%s\"",
    "version:major": "npm version major -m \"chore: release v%s\"",
    "version:prerelease": "npm version prerelease --preid=beta -m \"chore: release v%s\"",
    "postversion": "git push && git push --tags",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepare": "husky",
    "prepublishOnly": "pnpm types:check && pnpm run type-check && pnpm run test && pnpm run build",
    "precommit": "pnpm run type-check && pnpm run test",
    "example": "tsx examples/01-basic-usage.ts",
    "example:cancel": "tsx examples/19-request-cancellation.ts"
  },
  "keywords": [
    "port",
    "port.io",
    "getport",
    "internal-developer-portal",
    "idp",
    "developer-portal",
    "service-catalog",
    "api",
    "sdk",
    "typescript",
    "javascript",
    "rest-api",
    "client",
    "port-experimental"
  ],
  "author": "Uday Korlimarla <222185270+udayk-port@users.noreply.github.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/port-experimental/port-js.git"
  },
  "bugs": {
    "url": "https://github.com/port-experimental/port-js/issues"
  },
  "homepage": "https://github.com/port-experimental/port-js#readme",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "^20.19.25",
    "@vitest/coverage-v8": "4.0.15",
    "@vitest/ui": "^4.0.15",
    "conventional-changelog-cli": "^5.0.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "undici": "^7.16.0"
  },
  "pnpm": {
    "overrides": {
      "@conventional-changelog/git-client": ">=2.0.0"
    }
  }
}
